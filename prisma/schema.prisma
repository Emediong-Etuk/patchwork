// PATCHWORK data model.
// Credentials (GitHub tokens, Switch agent API keys) live in the Credential
// table, encrypted with AES-256-GCM (see src/lib/security/crypto.ts). No other
// table stores secrets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum RepositoryProvider {
  GITHUB
  LOCAL
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  NEW
  TRIAGING
  INVESTIGATING
  FIXING
  TESTING
  AWAITING_APPROVAL
  APPROVED
  RESOLVED
  NEEDS_INFORMATION
  BLOCKED
  FAILED
  REJECTED
  CANCELLED
}

enum AgentRole {
  TRIAGE
  INVESTIGATOR
  FIXER
  QA
}

enum AgentStatus {
  IDLE
  WORKING
  WAITING
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SenderType {
  AGENT
  HUMAN
  SYSTEM
}

enum MessageType {
  STATUS_UPDATE
  TASK_DELEGATION
  FINDING
  IMPLEMENTATION
  QA_REPORT
  HUMAN
  SYSTEM
  CHAT
}

enum EvidenceType {
  CODE_REFERENCE
  ERROR_LOG
  STACK_TRACE
  TERMINAL_OUTPUT
  TEST_RESULT
  REPOSITORY_METADATA
  AGENT_OBSERVATION
  EXTERNAL_DEPENDENCY
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  CONTRADICTED
  SUPERSEDED
}

enum ChangeType {
  ADDED
  MODIFIED
  DELETED
}

enum TestRunStatus {
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  ERROR
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ActorType {
  AGENT
  USER
  SYSTEM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  approvals       Approval[]
  credentials     Credential[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  repositories Repository[]
  incidents    Incident[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Repository {
  id                   String             @id @default(cuid())
  workspaceId          String
  provider             RepositoryProvider
  externalRepositoryId String?
  owner                String
  name                 String
  fullName             String
  defaultBranch        String
  visibility           String             @default("private")
  description          String?
  htmlUrl              String?
  // LOCAL repositories only: absolute path of the source directory.
  localPath            String?
  // Optional test command override; must still pass the command allowlist.
  testCommand          String?
  connectionStatus     ConnectionStatus   @default(CONNECTED)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([workspaceId, provider, fullName])
  @@index([workspaceId])
}

model Incident {
  id                String         @id @default(cuid())
  number            Int            @default(autoincrement())
  workspaceId       String
  repositoryId      String
  title             String
  description       String
  severity          Severity?
  status            IncidentStatus @default(NEW)
  errorMessage      String?
  stackTrace        String?
  reproductionSteps String?
  // Triage output, kept on the incident for quick display.
  affectedArea      String?
  rootCause         String?
  switchRoomId      String?
  switchRoomName    String?
  switchMode        String?
  workingBranch     String?
  workspacePath     String?
  baseCommit        String?
  headCommit        String?
  fixAttempts       Int            @default(0)
  maxFixAttempts    Int            @default(3)
  pullRequestUrl    String?
  pullRequestNumber Int?
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  resolvedAt        DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository  Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  tasks       AgentTask[]
  messages    AgentMessage[]
  evidence    Evidence[]
  codeChanges CodeChange[]
  testRuns    TestRun[]
  approvals   Approval[]
  events      ActivityEvent[]

  @@unique([number])
  @@index([workspaceId, status])
  @@index([repositoryId])
  @@index([createdAt])
}

model Agent {
  id            String      @id
  name          String      @unique
  switchName    String      @unique
  role          AgentRole   @unique
  title         String
  description   String
  provider      String
  model         String
  status        AgentStatus @default(IDLE)
  currentTask   String?
  lastActiveAt  DateTime?
  configuration Json        @default("{}")
  // Switch identity. The API key lives in Credential (kind SWITCH_AGENT_KEY).
  switchAgentId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tasks    AgentTask[]
  messages AgentMessage[]
  evidence Evidence[]
  testRuns TestRun[]
}

model AgentTask {
  id          String     @id @default(cuid())
  incidentId  String
  agentId     String
  // Idempotency key: one task per incident/stage/attempt.
  key         String
  stage       String
  attempt     Int        @default(1)
  title       String
  description String
  status      TaskStatus @default(PENDING)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([incidentId, key])
  @@index([incidentId])
  @@index([agentId, status])
}

model AgentMessage {
  id              String      @id @default(cuid())
  incidentId      String
  agentId         String?
  senderType      SenderType
  senderName      String
  messageType     MessageType
  content         String
  metadata        Json        @default("{}")
  // Switch message id; unique per incident so duplicate deliveries collapse.
  switchMessageId String?
  createdAt       DateTime    @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([incidentId, switchMessageId])
  @@index([incidentId, createdAt])
}

model Evidence {
  id                 String             @id @default(cuid())
  incidentId         String
  agentId            String?
  type               EvidenceType
  title              String
  description        String
  source             String
  filePath           String?
  lineStart          Int?
  lineEnd            Int?
  command            String?
  content            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  // How this evidence was used, e.g. "Supports root cause".
  influence          String?
  // Why PATCHWORK assigned the verification status.
  verificationNote   String?
  attempt            Int                @default(1)
  taskId             String?
  createdAt          DateTime           @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
}

model CodeChange {
  id         String     @id @default(cuid())
  incidentId String
  attempt    Int        @default(1)
  filePath   String
  changeType ChangeType
  additions  Int
  deletions  Int
  diff       String
  commitSha  String?
  createdAt  DateTime   @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, attempt])
}

model TestRun {
  id          String        @id @default(cuid())
  incidentId  String
  agentId     String?
  attempt     Int           @default(1)
  command     String
  status      TestRunStatus
  exitCode    Int?
  output      String        @default("")
  errorOutput String        @default("")
  durationMs  Int?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([incidentId, startedAt])
}

model Approval {
  id         String           @id @default(cuid())
  incidentId String
  userId     String
  decision   ApprovalDecision
  reason     String?
  createdAt  DateTime         @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model ActivityEvent {
  // Monotonic sequence; doubles as the SSE event id for resumable streams.
  seq         BigInt    @id @default(autoincrement())
  id          String    @unique @default(cuid())
  incidentId  String?
  workspaceId String?
  actorType   ActorType
  actorId     String?
  eventType   String
  description String
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, seq])
  @@index([workspaceId, seq])
}

// Encrypted secrets. `ciphertext` is AES-256-GCM output (iv:tag:data, base64).
model Credential {
  id         String   @id @default(cuid())
  userId     String?
  kind       String
  scope      String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, scope])
}

// Single-row-per-key runtime state (e.g. Switch connection health).
model SystemState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
