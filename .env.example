# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patchwork?schema=public"
APP_URL="http://localhost:3000"
# Signs session cookies and Switch handoff markers. Generate: openssl rand -hex 32
AUTH_SECRET=""
# AES-256-GCM key for stored credentials (GitHub tokens, Switch agent keys). 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=""
# Demo access: anyone with this code can sign in by name + email.
PATCHWORK_ACCESS_CODE="patchwork-demo"

# ── Switch (multi-agent collaboration) ───────────────────────────────────────
# "live"      = connect to a real Switch server's agent bridge (recommended).
# "simulator" = in-process local simulator of the protocol's semantics. Clearly
#               labelled in the UI; NOT Switch. For development without a server.
SWITCH_MODE="simulator"
# The Switch server's API URL (the agent bridge base URL). `curl $SWITCH_BRIDGE_URL/health`
# must return {"status":"ok"}. Self-hosted Compose publishes it on port 8000.
SWITCH_BRIDGE_URL="http://localhost:8000"
# The server's AGENT_REGISTRATION_TOKEN. Used once to register PATCHWORK's five agents;
# their API keys are then stored encrypted in the database.
SWITCH_REGISTRATION_TOKEN=""
# Agent names become <prefix>-triage, <prefix>-investigator, <prefix>-fixer, <prefix>-qa, <prefix>-relay
SWITCH_AGENT_PREFIX="patchwork"
# "false" = incident rooms use the server's default bridge (e.g. Mattermost/Slack), so people
# can follow and join the conversation in their chat app. "true" = agent-only rooms.
SWITCH_ROOM_INTERNAL_ONLY="false"
# Comma-separated chat usernames to add to every incident room (bridged rooms only).
SWITCH_HUMAN_USERNAMES=""

# ── AI provider ──────────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Server-side refusal fallback on supported models.
ANTHROPIC_FALLBACKS="true"
# Smaller model for classification; stronger models for code work.
TRIAGE_MODEL="claude-haiku-5-5"
INVESTIGATOR_MODEL="claude-opus-5-5"
FIXER_MODEL="claude-opus-5-5"
QA_MODEL="claude-sonnet-5-5"
AGENT_MAX_STEPS="40"
AGENT_TIMEOUT_MS="600000"

# ── GitHub ───────────────────────────────────────────────────────────────────
# Optional OAuth App (callback: $APP_URL/api/github/oauth/callback, scope: repo).
# Without it, users connect with a fine-grained personal access token in the UI.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Repository execution ─────────────────────────────────────────────────────
PATCHWORK_WORKSPACES_DIR=".patchwork/workspaces"
# "docker" runs test commands in a container with no network and CPU/memory/PID limits.
EXECUTION_MODE="process"
EXECUTION_DOCKER_IMAGE="node:22-bookworm-slim"
EXECUTION_TIMEOUT_MS="120000"
EXECUTION_MAX_OUTPUT_BYTES="200000"
MAX_FIX_ATTEMPTS="3"

# ── Observability (optional) ─────────────────────────────────────────────────
# Log every Prisma query.
PRISMA_LOG="0"
